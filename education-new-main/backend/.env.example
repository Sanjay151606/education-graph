# ==========================================
# Backend Environment Configuration (Render)
# ==========================================

# Port (Render automatically sets this in production)
PORT=8000

# Vercel Frontend Domain for CORS (comma-separated if multiple)
FRONTEND_URL=https://YOUR_VERCEL_FRONTEND.vercel.app
CORS_ORIGINS=https://YOUR_VERCEL_FRONTEND.vercel.app

# Database Connection (Supabase PostgreSQL or PostgreSQL connection URI)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# JWT Authentication
SECRET_KEY=YOUR_JWT_SECRET_KEY_CHANGE_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Credentials
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
AI_PROVIDER=openai

# Application Environment
ENVIRONMENT=production
