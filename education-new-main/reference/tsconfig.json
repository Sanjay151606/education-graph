{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "react": ["../frontend/node_modules/@types/react"],
      "react/*": ["../frontend/node_modules/@types/react/*"],
      "react/jsx-runtime": ["../frontend/node_modules/@types/react/jsx-runtime"],
      "react-dom": ["../frontend/node_modules/@types/react-dom"],
      "react-dom/*": ["../frontend/node_modules/@types/react-dom/*"],
      "react-router-dom": ["../frontend/node_modules/@types/react-router-dom"],
      "*": ["./*", "../frontend/node_modules/*"]
    },
    "typeRoots": [
      "../frontend/node_modules/@types"
    ],
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "*.ts",
    "*.tsx"
  ]
}
